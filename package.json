{
  "name": "@bkincz/drift",
  "version": "1.4.0",
  "type": "module",
  "description": "A DOM-driven form library that automatically tracks forms and fields based on their presence in the DOM.",
  "author": "Benjamin Kinczel <beni.kinczel@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkincz/drift.git"
  },
  "bugs": {
    "url": "https://github.com/bkincz/drift/issues"
  },
  "homepage": "https://github.com/bkincz/drift#readme",
  "main": "./dist/drift.umd.cjs",
  "module": "./dist/drift.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/drift.js",
      "require": "./dist/drift.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build && pnpm run size",
    "prepublishOnly": "pnpm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "ESM bundle",
      "path": "dist/drift.js",
      "limit": "7 KB"
    },
    {
      "name": "UMD bundle",
      "path": "dist/drift.umd.cjs",
      "limit": "7 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.6.0"
}
